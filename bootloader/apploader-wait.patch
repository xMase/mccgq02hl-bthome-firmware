+static uint32_t now(void)
+{
+  return sl_rail_get_time(SL_RAIL_EFR32_HANDLE);
+}
+
+// End of the wait: a valid app boots through the SDK's GO reset (btl_main.c), so the app finds a
+// valid reset word. With no valid app, EM4 with no wake source: only a new battery restarts.
+static int32_t waitEnd(void)
+{
+  GPIO_PinOutClear(LED_PORT, LED_PIN);
+  if (!bootload_verifyApplication(BTL_APPLICATION_BASE)) {
+    EMU_EnterEM4();
+  }
+  return BOOTLOADER_ERROR_COMMUNICATION_DONE;
+}
