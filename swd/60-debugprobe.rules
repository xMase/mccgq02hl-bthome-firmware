# Raspberry Pi Debugprobe (CMSIS-DAP): let the logged-in user open it without root.
ACTION=="add|change", SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000c", TAG+="uaccess"
