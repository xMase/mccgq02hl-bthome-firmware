    </service>
    <service advertise="true" id="speed" name="Speed" requirement="mandatory" sourceId="custom.type" type="primary" uuid="7a1c0000-5a3e-4f6b-9a52-0c1f6e0d0001">
      <characteristic id="sink" name="Sink" sourceId="custom.type" uuid="7a1c0001-5a3e-4f6b-9a52-0c1f6e0d0001">
